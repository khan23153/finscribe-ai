# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/finscribe

# Optional: AI features return a clear configuration error when this is absent.
GEMINI_API_KEY=replace_me
GEMINI_MODEL=gemini-2.5-flash

# Android: the HTTPS origin for this deployment and its actual APK signing certificates.
FINSCRIBE_APP_ORIGIN=https://finscribe-ai.vercel.app
# Comma-separated SHA-256 fingerprints from apksigner; leave empty until configured.
ANDROID_SHA256_CERT_FINGERPRINTS=
